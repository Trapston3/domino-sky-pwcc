# Option 1: Vertex AI Express / API key authentication
GOOGLE_VERTEX_API_KEY=

# Option 2: Base64-encoded GCP Service Account JSON (used if GOOGLE_VERTEX_API_KEY is unset)
GCP_SERVICE_ACCOUNT_B64=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Vertex model ID (default: gemini-3.8-flash)
VERTEX_MODEL=gemini-3.8-flash
